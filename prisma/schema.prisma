generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MANAGER
  CUSTOMER
}

enum NotificationChannel {
  EMAIL
  SMS
}

model Account {
  id           String   @id @default(uuid())
  email        String
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  manager      Manager?
  customer     Customer?

  @@unique([email])
}

model Manager {
  id        String  @id @default(uuid())
  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Customer {
  id                  String              @id @default(uuid())
  accountId           String              @unique
  account             Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  notificationChannel NotificationChannel @default(EMAIL)
  phoneNumber         String?
}
